# Environment Configuration Template for HRM Module

# Copy this to .env.local and fill in your values
# Never commit .env.local to version control

# ────────────────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────

# Choose service: "gmail-smtp" (recommended), "smtp", or "gmail-api"
EMAIL_SERVICE=gmail-smtp

# Email sender details
EMAIL_FROM=admin@nartyrock.edu.zm
EMAIL_FROM_NAME=Narty Rock Private School

# ────────────────────────────────────────────────────────────────────────────
# GMAIL SMTP CONFIGURATION (for EMAIL_SERVICE=gmail-smtp)
# ────────────────────────────────────────────────────────────────────────────
# Recommended: Use Gmail App Password
# 
# Setup instructions:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Google will generate a 16-character password
# 5. Use that password below (without spaces)
#

GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_SMTP_USER=admin@nartyrock.edu.zm
GMAIL_SMTP_PASS=your-16-character-app-password

# ────────────────────────────────────────────────────────────────────────────
# GENERIC SMTP CONFIGURATION (for EMAIL_SERVICE=smtp)
# ────────────────────────────────────────────────────────────────────────────
# Use these if you have a custom mail server
#

# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# ────────────────────────────────────────────────────────────────────────────
# GMAIL API CONFIGURATION (for EMAIL_SERVICE=gmail-api)
# ────────────────────────────────────────────────────────────────────────────
# Advanced setup - requires OAuth2 configuration
# See: https://developers.google.com/gmail/api/quickstart/nodejs
#

# GMAIL_API_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_API_CLIENT_SECRET=your-client-secret
# GMAIL_API_REFRESH_TOKEN=your-refresh-token

# ────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (when migrating from mock data)
# ────────────────────────────────────────────────────────────────────────────
#

# DATABASE_URL=postgresql://user:password@localhost:5432/narty_rock_db

# ────────────────────────────────────────────────────────────────────────────
# NODE ENVIRONMENT
# ────────────────────────────────────────────────────────────────────────────
#

NODE_ENV=development
# NODE_ENV=production (for production deployment)
